# --- LE PLUS IMPORTANT : ne jamais versionner les cles ni les donnees ---
data/keys/
*.key

data/to_encrypt/*
data/encrypted/*
data/decrypted/*

# Pipeline : jobs recus par le serveur, et racine de confiance generee au
# premier demarrage. En production, data/trust/ serait au contraire versionne
# (c'est la reference que le client doit connaitre a l'avance).
data/server_storage/*
data/trust/*
!data/**/.gitkeep
!data/to_encrypt/example_mandible.vtk

*.enc
*.part

# Python / uv
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
# NB : uv.lock n'est PAS ignore. Il fige les versions et doit etre versionne.
